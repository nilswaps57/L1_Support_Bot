# All settings have code-level defaults. These values make the local Ollama/Qdrant
# development path explicit when the backend is started from backend/.
APP_NAME=L1 Support Bot
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./dev.db
QDRANT_URL=http://localhost:6333
FILE_STORAGE_PATH=./data/documents
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL_VERSION=dev
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3.5
OLLAMA_TIMEOUT_SECONDS=120
MAX_REQUEST_BODY_BYTES=10485760
MAX_DOCUMENT_SIZE_BYTES=10485760
SESSION_TTL_MINUTES=30
SESSION_HISTORY_WINDOW_TURNS=10
SESSION_HISTORY_TOKEN_BUDGET=2000
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# The current application has no Google adapter or consumed Google API-key
# setting. Do not add a GOOGLE_API_KEY or VITE_ secret until that adapter exists.
